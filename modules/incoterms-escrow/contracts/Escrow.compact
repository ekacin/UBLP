// UBLP Module 4 — INCOTERMS Settlement (Escrow). See AGENTS.md Section 5.
//
// Supports all 11 Incoterms 2020 rules (Section 5.2) through one shared state machine — a rule
// only changes which real-world event counts as the milestone below and who attests it
// (src/policies/), not the contract itself.
//
// State machine: Empty -> Proposed -> Locked -> Released
//   - Proposed: seller "creates the offer" (Section 5.12 step 1) — fixes the terms,
//     including C's identity.
//   - Locked: buyer "locks the funds" (Section 5.12 step 2) — locking is a PRECONDITION
//     for shipping to start (Section 7.5), not a step that happens afterward.
//   - Released: point (c) triggers payout in TWO SEPARATE circuits (see AGENTS.md 5.14.1,
//     "don't give C data irrelevant to its job"):
//       1. `attestMilestone` — callable only by C, proves only C's own identity. C's role
//          stops there — it never touches financial data (least privilege).
//       2. `claimPayout` — callable by anyone once attested (in practice the seller's own
//          agent, since it wants the funds); verifies the coin/address commitments and pays.
//     The 7-day timeout (Section 7.2) is a separate safety net that releases to the seller
//     if C never attests / a dispute never resolves — it doesn't require attestation.
//
// PRIVACY — two independent commitment patterns, same rationale for both:
//   1. Fund custody (shielded): coin data always comes from a witness; the ledger only
//      stores a persistentCommit hash — the amount never reaches the chain in plaintext.
//   2. Payout address: never written to the ledger directly (that would leak "A paid B",
//      exactly what we're trying to hide). Instead only a commitment is stored; the real
//      address is supplied via witness at payout time and checked against it. This keeps
//      the address both private AND immutable — `releaseOnTimeout` is deliberately
//      unauthenticated (anyone can call it, that's the point of a safety net), so if the
//      address could be supplied freely at that point, funds could be redirected anywhere.
//      Both seller AND buyer commit their own payout address (Section 5.19 — `timeoutDirection`
//      decides which commitment `releaseOnTimeout` pays out to).
//
// (See AGENTS.md 5.14.1 for the experiment that validated this commitment pattern.)
//
// AGENTS.md 5.36 (Discord finding #3 fix) — the deposited coin's `nonce`/`depositSalt` are now
// SELLER-chosen, committed at propose() time (depositParamsCommitment) exactly like
// agreedAmountCommitment, and conveyed to the buyer off-chain via the signed EscrowTerms (same
// trust model as amountSalt). lockEscrow() asserts the buyer actually used them. This replaces
// the old `buyerMemo` mechanism (seller recovering the coin by decrypting a buyer-supplied,
// unverified memo) — that memo's plaintext was never checked against heldCommitment, so a
// buyer could lock real funds while writing garbage into the memo, permanently freezing the
// deal (the seller could never recover the coin to claim payout). Removed entirely rather than
// patched: once the seller pre-commits the coin's own parameters, it never needs the memo at
// all.
pragma language_version >= 0.22;

import CompactStandardLibrary;

export enum EscrowState { Empty, Proposed, Locked, Released }

// Section 5.19 — who releaseOnTimeout pays if the deadline passes with no attestation from
// C. No universally "correct" default exists (either direction leaves someone exposed to
// C's failure), so it's a per-deal term like price or the deadline itself, not hardcoded.
// Buyer listed first only because it's the chosen default direction, not because either
// party can lock the other into it — see propose()'s `timeoutDir` argument.
export enum TimeoutDirection { Buyer, Seller }

struct CoinCore {
  nonce: Bytes<32>,
  color: Bytes<32>,
  value: Uint<128>
}

export ledger state: EscrowState;

// Terms fixed at propose time — immutable afterward.
export ledger portAuthorityKeyHash: Bytes<32>;   // "C" — Section 5.12
// The AGREED LENGTH of the safety window (e.g. 7 days) — fixed at propose time, same as
// price/timeoutDirection. The absolute deadline itself is fixed later, at lockEscrow time
// (see deadlineTimestamp below) — otherwise a buyer who delays locking eats into C's real
// window to attest, through no fault of C's.
export ledger durationSeconds: Uint<64>;
// Fixed at lockEscrow time, NOT propose time (see durationSeconds above) — this is the one
// field on this ledger whose value is anchored to a caller-supplied timestamp rather than
// derived purely from committed data; see lockEscrow()'s blockTimeGte/blockTimeLte check for
// why that's still safe (bounded to a small tolerance window, not an open self-declaration).
export ledger deadlineTimestamp: Uint<64>;
export ledger timeoutDirection: TimeoutDirection; // Section 5.19 — who releaseOnTimeout pays

// C's attestation — a single flag carrying no financial data. Rule-agnostic on purpose: the
// same flag serves every Incoterm rule's own milestone (loaded on board, handed to carrier,
// arrived at destination, ...) — which real-world event it stands for is an off-chain policy
// concern (src/policies/), not something this contract branches on. Exported so the seller's
// agent can watch it via the indexer and auto-trigger claimPayout (Section 5.14.1's
// "push the burden onto the system" principle).
export ledger milestoneConfirmed: Boolean;

// Only commitment hashes — neither the amount nor the buyer/seller address ever reaches
// the chain in plaintext (see privacy note above). `heldCommitment` is exported (AGENTS.md
// 5.36's Fix B) so the seller's own agent can read this already-public hash via the normal
// SDK accessor, instead of the raw-state-dump workaround verify-privacy.ts uses — exporting
// it changes nothing about what's physically on-chain (5.14.1: export only adds a TS
// getter), so this is not a privacy change, just a convenience one.
export ledger heldCommitment: Bytes<32>;
ledger sellerAddressCommitment: Bytes<32>;
ledger buyerAddressCommitment: Bytes<32>;   // Section 5.19 — mirrors sellerAddressCommitment

// The price seller and buyer agreed to off-chain (EscrowTerms.amount) was never checked
// against what the buyer actually locks — nothing stopped `lockEscrow` from accepting any
// coin value at all. This commitment closes that gap: seller commits to the agreed amount
// at propose time, lockEscrow must prove BOTH that the caller knows that exact amount AND
// that the locked coin's value equals it — knowing the number alone isn't enough.
ledger agreedAmountCommitment: Bytes<32>;

// AGENTS.md 5.36 — the seller's pre-committed coin nonce+depositSalt (see propose()/
// lockEscrow() below). persistentCommit(nonce, salt) binds BOTH values together using salt
// as the opening, the same shape agreedAmountCommitment already uses for amount+amountSalt.
ledger depositParamsCommitment: Bytes<32>;

// AGENTS.md Section 5.18 — dual-recipient encrypted memo. Solves a gap the commitment
// pattern above leaves open: only the party that generated a witness value (address+salt)
// can ever produce it again, so losing local storage means the funds are stuck forever —
// even `releaseOnTimeout` needs the same witness data. Each memo is encrypted off-chain
// (TypeScript) via a static-static X25519 ECDH shared secret, so EITHER the counterparty or
// the original author can recover it — see @ublp/shared/crypto/dualRecipientMemo. The
// contract only stores opaque bytes; it never sees the plaintext. Sizes are fixed by the
// plaintext layout chosen in src/contract/memo.ts: address+addressSalt (97 bytes), growing
// by 1 (scheme) + 12 (nonce) + 16 (AEAD tag) = 29 bytes once encrypted = 126 total.
//
// A THIRD memo (`buyerMemo`, coin+depositSalt) used to exist here for the same reason, but
// was removed (AGENTS.md 5.36, Discord finding #3): its plaintext was never checked against
// `heldCommitment`, so a buyer could lock real funds while writing a garbage memo, freezing
// the deal permanently. Fixed instead by having the seller pre-commit the coin's own
// nonce+salt at propose() time (see depositParamsCommitment below) — the seller never needs
// to recover this data from anywhere, so no memo is needed for it at all.
export ledger sellerMemo: Bytes<126>;
// Section 5.19 — buyer's own payout-address memo, kept SEPARATE from buyerMemo (coin
// custody data) on purpose: different concern, decoded independently, simpler to reason
// about and test than one combined blob (see AGENTS.md 5.19 discussion). Same 97-byte
// plaintext shape as sellerMemo (is_left + left + right + salt), same 126-byte total.
export ledger buyerAddressMemo: Bytes<126>;

witness portAuthoritySecretKey(): Bytes<32>;
witness depositedCoin(): ShieldedCoinInfo;
witness depositSalt(): Bytes<32>;
witness heldCoinForRelease(): QualifiedShieldedCoinInfo;
witness releaseSalt(): Bytes<32>;
witness proposedSellerAddress(): Either<ZswapCoinPublicKey, ContractAddress>;
witness sellerAddressSalt(): Bytes<32>;
witness payoutSellerAddress(): Either<ZswapCoinPublicKey, ContractAddress>;
witness payoutAddressSalt(): Bytes<32>;
witness sellerEncryptedMemo(): Bytes<126>;
witness agreedAmount(): Uint<128>;
witness agreedAmountSalt(): Bytes<32>;
witness lockedAmount(): Uint<128>;
witness lockedAmountSalt(): Bytes<32>;
witness proposedBuyerAddress(): Either<ZswapCoinPublicKey, ContractAddress>;
witness buyerAddressSalt(): Bytes<32>;
witness buyerAddressEncryptedMemo(): Bytes<126>;
witness payoutBuyerAddress(): Either<ZswapCoinPublicKey, ContractAddress>;
witness payoutBuyerAddressSalt(): Bytes<32>;

// AGENTS.md 5.35 (Discord finding #2 fix) — the buyer's OWN, independently-resolved value for
// C's role-key hash (via a real did:web HTTPS fetch, done off-chain before lockEscrow is
// called — see src/server/didWeb.ts), asserted against what the seller wrote at propose time
// below. Without this, propose() alone decided who "C" is and the buyer never checked it —
// the seller could name a key it controls itself and later self-attest as C. This doesn't
// make either party individually authoritative over C's identity; it requires BOTH to agree,
// which is the most either side can do without a central registry (already rejected, 5.12).
witness resolvedPortAuthorityKeyHash(): Bytes<32>;

// AGENTS.md 5.36 (Discord finding #3 fix) — the seller's own pre-chosen coin nonce+salt,
// used ONLY in propose() to compute depositParamsCommitment below. The buyer's lockEscrow()
// still calls the existing depositedCoin()/depositSalt() witnesses (unchanged) — only their
// TS-side source changes (seller-provided via signed terms, not buyer-random).
witness sellerDepositNonce(): Bytes<32>;
witness sellerDepositSalt(): Bytes<32>;

// Domain-separated hash-based authentication — see the security skill's Pattern 2. Used for
// C's role-key check in attestMilestone(); the domain separator keeps this independent of any
// other hash derived from the same secret key elsewhere.
pure circuit roleKeyHash(sk: Bytes<32>, domain: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([domain, sk]);
}

// Deliberately no seller role-key check here (there was one, `sellerKeyHash`, removed
// 2026-10-22 — see AGENTS.md 5.34). It was never read by any circuit; "the seller" is defined
// entirely by who holds `sellerAddressSalt` (see sellerAddressCommitment below), the same way
// an address-commitment-based role already works elsewhere in this contract. Don't re-add a
// role-key check here without re-reading 5.34 first — it wouldn't add real authorization, and
// the thing it accidentally used to also catch (roleKeyHash() TS drift from the real circuit)
// is already caught by attestMilestone()'s own check, which every devnet script exercises.
export circuit propose(portAuthKeyHash: Bytes<32>, durationSecondsArg: Uint<64>, timeoutDir: TimeoutDirection): [] {
  assert(state == EscrowState.Empty, "escrow already proposed");
  portAuthorityKeyHash = disclose(portAuthKeyHash);
  durationSeconds = disclose(durationSecondsArg);
  timeoutDirection = disclose(timeoutDir);

  const sellerAddr = proposedSellerAddress();
  const addrSalt = sellerAddressSalt();
  sellerAddressCommitment = disclose(
    persistentCommit<Either<ZswapCoinPublicKey, ContractAddress>>(sellerAddr, addrSalt)
  );
  sellerMemo = disclose(sellerEncryptedMemo());

  const amount = agreedAmount();
  const amountSalt = agreedAmountSalt();
  agreedAmountCommitment = disclose(persistentCommit<Uint<128>>(amount, amountSalt));

  // AGENTS.md 5.36 — seller pre-commits the coin's own nonce+salt here, the same way it just
  // pre-committed the amount above. depositSalt doubles as this commitment's opening AND
  // (later, at lockEscrow time) heldCommitment's opening — exactly how amountSalt already
  // serves two commitments (agreedAmountCommitment here, the lockedAmount check below).
  const depNonce = sellerDepositNonce();
  const depSalt = sellerDepositSalt();
  depositParamsCommitment = disclose(persistentCommit<Bytes<32>>(depNonce, depSalt));

  state = EscrowState.Proposed;
}

export circuit lockEscrow(claimedLockTime: Uint<64>): [] {
  assert(state == EscrowState.Proposed, "no active proposal");

  // Discord finding #2 fix (5.35) — double-commitment check. The seller wrote
  // portAuthorityKeyHash at propose() time from data C published itself; this proves the
  // buyer independently resolved the SAME value via did:web before locking funds, instead of
  // just trusting the seller's say-so. Checked here (not just off-chain before submitting)
  // because this is the actual authorization boundary — an off-chain-only check could be
  // skipped by a modified client, this can't.
  assert(
    resolvedPortAuthorityKeyHash() == portAuthorityKeyHash,
    "buyer's independently resolved port-authority key hash does not match the one the seller proposed"
  );

  // Efe Kaan AÇİN, 22 Ekim 2026: bu satırı yazana kadar üç farklı mimariyi denedim ve kendi
  //   sorduğum bir soruyla ikisini elemek zorunda kaldım. Lojistikten buraya kadar geldim,
  //   devam edeceğim.

  // How far claimedLockTime (buyer's self-declared "now") may lag behind the real block time
  // before it's rejected. Bounds the exploit a fully-open self-declared timestamp would allow
  // (a buyer claiming an arbitrarily early "now" to shrink C's real attestation window
  // towards zero) down to a few minutes — negligible against a multi-day safety window, not
  // zero risk but not a meaningful one either.
  const toleranceSeconds: Uint<64> = 300;

  const lt = disclose(claimedLockTime);
  assert(
    blockTimeGte(lt) && blockTimeLte((lt + toleranceSeconds) as Uint<64>),
    "claimed lock time is not close enough to the real block time"
  );
  deadlineTimestamp = disclose((lt + durationSeconds) as Uint<64>);

  const coin = depositedCoin();
  const salt = depositSalt();

  // AGENTS.md 5.36 (Discord finding #3 fix) — the buyer must actually use the nonce+salt the
  // seller pre-committed to at propose() time (conveyed off-chain via the signed terms, same
  // as amountSalt). Without this, nothing stopped the buyer from locking real funds under one
  // nonce/salt while telling the seller (via the old buyerMemo) a different one — the seller
  // could never then recover the real coin to claim payout.
  assert(
    persistentCommit<Bytes<32>>(coin.nonce, salt) == depositParamsCommitment,
    "deposited coin's nonce/salt do not match what the seller committed to at propose time"
  );

  const amount = lockedAmount();
  const amountSalt = lockedAmountSalt();
  assert(
    persistentCommit<Uint<128>>(amount, amountSalt) == agreedAmountCommitment,
    "locked amount does not match the amount agreed to at propose time"
  );
  assert(coin.value == amount, "deposited coin value does not match the agreed amount");

  receiveShielded(disclose(coin));
  const core = CoinCore { nonce: coin.nonce, color: coin.color, value: coin.value };
  heldCommitment = disclose(persistentCommit<CoinCore>(core, salt));

  const buyerAddr = proposedBuyerAddress();
  const buyerAddrSalt = buyerAddressSalt();
  buyerAddressCommitment = disclose(
    persistentCommit<Either<ZswapCoinPublicKey, ContractAddress>>(buyerAddr, buyerAddrSalt)
  );
  buyerAddressMemo = disclose(buyerAddressEncryptedMemo());

  state = EscrowState.Locked;
}

export circuit attestMilestone(): [] {
  assert(state == EscrowState.Locked, "escrow not locked");
  assert(!milestoneConfirmed, "milestone already confirmed");
  const sk = portAuthoritySecretKey();
  assert(
    roleKeyHash(sk, pad(32, "incoterms-escrow:port-auth:v1")) == portAuthorityKeyHash,
    "caller is not the designated port authority (C) for this escrow"
  );
  milestoneConfirmed = true;
}

export circuit claimPayout(): [] {
  assert(state == EscrowState.Locked, "escrow not locked");
  assert(milestoneConfirmed, "milestone not yet confirmed by C");
  payOutToSeller();
}

export circuit releaseOnTimeout(): [] {
  assert(state == EscrowState.Locked, "escrow not locked");
  // Once C has attested, this is no longer a "C never attested" safety net — claimPayout is
  // the only correct path from here. Without this check, a party could race claimPayout after
  // the deadline and redirect funds via releaseOnTimeout even though the milestone was already
  // confirmed, contradicting this circuit's own documented purpose (see file header).
  assert(!milestoneConfirmed, "milestone already confirmed — use claimPayout instead");
  assert(blockTimeGte(deadlineTimestamp), "deadline not yet reached");
  if (timeoutDirection == TimeoutDirection.Buyer) {
    payOutToBuyer();
  } else {
    payOutToSeller();
  }
}

circuit payOutToSeller(): [] {
  const qcoin = heldCoinForRelease();
  const coinSalt = releaseSalt();
  const core = CoinCore { nonce: qcoin.nonce, color: qcoin.color, value: qcoin.value };
  assert(persistentCommit<CoinCore>(core, coinSalt) == heldCommitment, "coin/commitment mismatch");

  const sellerAddr = payoutSellerAddress();
  const addrSalt = payoutAddressSalt();
  assert(
    persistentCommit<Either<ZswapCoinPublicKey, ContractAddress>>(sellerAddr, addrSalt)
      == sellerAddressCommitment,
    "seller address does not match the address committed to at propose time"
  );

  sendShielded(disclose(qcoin), disclose(sellerAddr), disclose(qcoin.value));
  state = EscrowState.Released;
}

// Section 5.19 — only reachable from releaseOnTimeout with timeoutDirection == Buyer.
// claimPayout always pays the seller (C's attestation already confirms seller performed);
// this path exists purely as the buyer-refund safety net when C never attests.
circuit payOutToBuyer(): [] {
  const qcoin = heldCoinForRelease();
  const coinSalt = releaseSalt();
  const core = CoinCore { nonce: qcoin.nonce, color: qcoin.color, value: qcoin.value };
  assert(persistentCommit<CoinCore>(core, coinSalt) == heldCommitment, "coin/commitment mismatch");

  const buyerAddr = payoutBuyerAddress();
  const addrSalt = payoutBuyerAddressSalt();
  assert(
    persistentCommit<Either<ZswapCoinPublicKey, ContractAddress>>(buyerAddr, addrSalt)
      == buyerAddressCommitment,
    "buyer address does not match the address committed to at lockEscrow time"
  );

  sendShielded(disclose(qcoin), disclose(buyerAddr), disclose(qcoin.value));
  state = EscrowState.Released;
}
