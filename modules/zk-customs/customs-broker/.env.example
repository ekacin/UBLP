# Gümrük müşavirinin bağlandığı servis URL'leri
MINISTRY_URL=http://localhost:3001
UBLP_AGENT_URL=http://localhost:3002

# Operatör girişi (panel) için parola — ayarlanmazsa operator login devre dışı kalır
BROKER_OPERATOR_PASSPHRASE=

# Ministry'ye giden isteklere eklenen paylaşılan anahtar (x-api-key header'ı).
# Ministry tarafında da AYNI değer MINISTRY_BROKER_API_KEY olarak ayarlanmalı.
# Ayarlanmazsa Ministry'ye giden çağrılar reddedilir.
MINISTRY_BROKER_API_KEY=

# Belgeye gömülecek nakliyeci DID'i (holderDid)
# Nakliyeci (UBLP Agent) hangi DID ile çalışıyorsa buraya aynısı yazılır
AGENT_DID=did:ublp:agent:default
