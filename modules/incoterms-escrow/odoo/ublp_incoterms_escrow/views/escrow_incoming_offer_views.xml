<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_ublp_escrow_incoming_offer_list" model="ir.ui.view">
        <field name="name">ublp.escrow.incoming.offer.list</field>
        <field name="model">ublp.escrow.incoming.offer</field>
        <field name="arch" type="xml">
            <list create="0">
                <field name="received_at"/>
                <field name="seller_did"/>
                <field name="shipment_id"/>
                <field name="incoterm"/>
                <field name="agreed_amount"/>
                <field name="status" widget="badge"
                       decoration-info="status == 'pending'"
                       decoration-muted="status in ('dismissed', 'used')"/>
            </list>
        </field>
    </record>

    <record id="view_ublp_escrow_incoming_offer_form" model="ir.ui.view">
        <field name="name">ublp.escrow.incoming.offer.form</field>
        <field name="model">ublp.escrow.incoming.offer</field>
        <field name="arch" type="xml">
            <form create="0">
                <header>
                    <button name="action_accept" type="object" string="Accept &amp; Lock"
                            class="btn-primary" invisible="status != 'pending'"/>
                    <button name="action_dismiss" type="object" string="Dismiss"
                            invisible="status != 'pending'"/>
                    <field name="status" widget="statusbar" statusbar_visible="pending,used"/>
                </header>
                <sheet>
                    <group>
                        <field name="seller_did"/>
                        <field name="shipment_id"/>
                        <field name="contract_address"/>
                        <field name="incoterm"/>
                        <field name="agreed_amount"/>
                        <field name="duration_seconds"/>
                        <field name="timeout_direction"/>
                        <field name="port_authority_did"/>
                        <field name="received_at"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_ublp_escrow_incoming_offer" model="ir.actions.act_window">
        <field name="name">Incoming Offers</field>
        <field name="res_model">ublp.escrow.incoming.offer</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_pending': 1}</field>
    </record>

    <record id="action_ublp_escrow_sync_incoming_now" model="ir.actions.server">
        <field name="name">Sync incoming offers now</field>
        <field name="model_id" ref="model_ublp_escrow_incoming_offer"/>
        <field name="binding_model_id" ref="model_ublp_escrow_incoming_offer"/>
        <field name="state">code</field>
        <field name="code">model.action_sync_incoming()</field>
    </record>

    <record id="view_ublp_escrow_incoming_offer_search" model="ir.ui.view">
        <field name="name">ublp.escrow.incoming.offer.search</field>
        <field name="model">ublp.escrow.incoming.offer</field>
        <field name="arch" type="xml">
            <search>
                <filter name="pending" string="Pending" domain="[('status', '=', 'pending')]"/>
            </search>
        </field>
    </record>

    <menuitem id="menu_ublp_escrow_incoming" name="Incoming Offers" parent="menu_ublp_escrow_root"
              action="action_ublp_escrow_incoming_offer" sequence="15"/>

</odoo>
