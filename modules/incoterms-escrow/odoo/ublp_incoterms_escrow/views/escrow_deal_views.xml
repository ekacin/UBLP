<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_ublp_escrow_deal_list" model="ir.ui.view">
        <field name="name">ublp.escrow.deal.list</field>
        <field name="model">ublp.escrow.deal</field>
        <field name="arch" type="xml">
            <list create="0">
                <field name="shipment_id"/>
                <field name="created_as_role" widget="badge"
                       decoration-info="created_as_role == 'seller'"
                       decoration-warning="created_as_role == 'buyer'"/>
                <field name="contract_address"/>
                <field name="incoterm"/>
                <field name="agreed_amount"/>
                <field name="status" widget="badge"
                       decoration-info="status in ('empty','proposed')"
                       decoration-warning="status == 'locked'"
                       decoration-success="status == 'released'"/>
                <field name="pending_action_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_ublp_escrow_deal_search" model="ir.ui.view">
        <field name="name">ublp.escrow.deal.search</field>
        <field name="model">ublp.escrow.deal</field>
        <field name="arch" type="xml">
            <search>
                <field name="shipment_id"/>
                <field name="contract_address"/>
                <!-- Default groupby on purpose — a company that is sometimes buyer and
                     sometimes seller otherwise sees both sides' rows for the same shipment_id
                     interleaved with no way to tell them apart at a glance (found live, during
                     manual testing — see created_as_role's own docstring). -->
                <filter string="I was the seller" name="filter_role_seller" domain="[('created_as_role', '=', 'seller')]"/>
                <filter string="I was the buyer" name="filter_role_buyer" domain="[('created_as_role', '=', 'buyer')]"/>
                <group name="group_by">
                    <filter string="My role" name="groupby_role" context="{'group_by': 'created_as_role'}"/>
                    <filter string="Status" name="groupby_status" context="{'group_by': 'status'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_ublp_escrow_deal_form" model="ir.ui.view">
        <field name="name">ublp.escrow.deal.form</field>
        <field name="model">ublp.escrow.deal</field>
        <field name="arch" type="xml">
            <form create="0">
                <header>
                    <button name="action_refresh_status" type="object" string="Refresh status"
                            invisible="not contract_address"/>
                    <button name="action_approve_pending" type="object" string="Approve"
                            class="btn-primary" invisible="not pending_action_id or is_submitting"
                            confirm="This submits a real transaction to the blockchain — a ZK proof plus on-chain submission, usually 1-2 minutes. The page will look frozen/unresponsive the whole time; that's normal, don't click Approve again or close the tab. Continue?"/>
                    <button name="action_reject_pending" type="object" string="Reject"
                            invisible="not pending_action_id or is_submitting"/>
                    <button name="action_attest" type="object" string="Confirm milestone completed"
                            invisible="status != 'locked' or milestone_confirmed or is_submitting or configured_role != 'port-authority'"
                            confirm="This submits a real on-chain transaction, usually 1-2 minutes, and the page will look frozen the whole time — that's normal. Continue?"/>
                    <button name="action_claim" type="object" string="Collect payment"
                            class="btn-primary"
                            invisible="status != 'locked' or not milestone_confirmed or is_submitting or configured_role != 'seller'"
                            confirm="This submits a real on-chain transaction, usually 1-2 minutes, and the page will look frozen the whole time — that's normal. Continue?"/>
                    <button name="action_release_timeout" type="object" string="Take my money back"
                            invisible="status != 'locked' or milestone_confirmed or timeout_direction != 'buyer' or is_submitting or configured_role != 'buyer'"
                            confirm="This submits a real on-chain transaction, usually 1-2 minutes, and the page will look frozen the whole time — that's normal. Continue?"/>
                    <field name="status" widget="statusbar" statusbar_visible="empty,proposed,locked,released"/>
                </header>
                <!-- Not shown as a widget — only here so the client fetches is_submitting at
                     all. Every field referenced in an invisible="..." expression above must
                     also appear as a <field> somewhere in the view, or the client never has
                     its value and errors ("Name 'is_submitting' is not defined") trying to
                     evaluate those expressions. -->
                <field name="is_submitting" invisible="1"/>
                <field name="configured_role" invisible="1"/>
                <div class="alert alert-info" role="alert" invisible="not is_submitting">
                    ⏳ Submitting to the settlement-agent — a real ZK proof and on-chain
                    transaction, this can take a minute or two. Don't close this page or click
                    again; use <strong>Refresh status</strong> (or just reopen this record) once
                    it's done.
                </div>
                <sheet>
                    <group>
                        <group string="Deal">
                            <field name="shipment_id"/>
                            <field name="contract_address"/>
                            <field name="incoterm"/>
                            <field name="agreed_amount"/>
                            <field name="duration_seconds"/>
                            <field name="timeout_direction"/>
                        </group>
                        <group string="Parties">
                            <field name="seller_did"/>
                            <field name="buyer_did"/>
                            <field name="port_authority_did"/>
                            <field name="port_authority_key_hash"/>
                            <field name="buyer_memo_public_key"/>
                        </group>
                    </group>
                    <group string="On-chain status">
                        <field name="onchain_state" readonly="1"/>
                        <field name="milestone_confirmed" readonly="1"/>
                        <field name="deadline_timestamp" readonly="1"/>
                        <field name="pending_action_id" readonly="1"/>
                    </group>
                    <group string="Signed offer — for the buyer" invisible="not signed_proposal_json">
                        <field name="offer_delivered" readonly="1"/>
                        <div class="alert alert-warning" role="alert" invisible="offer_delivered">
                            Not delivered automatically — the buyer has no way to see this yet.
                            Copy the JSON below and send it to them out-of-band; they paste it
                            into their own Lock Deal wizard. This is the only copy — the agent
                            does not keep it anywhere else.
                        </div>
                        <field name="signed_proposal_json" readonly="1" widget="text" nolabel="1"
                               colspan="2"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_ublp_escrow_deal" model="ir.actions.act_window">
        <field name="name">Deals</field>
        <field name="res_model">ublp.escrow.deal</field>
        <field name="view_mode">list,form</field>
        <!-- Grouped by role by default — see view_ublp_escrow_deal_search's own comment. -->
        <field name="context">{'search_default_groupby_role': 1}</field>
    </record>

    <menuitem id="menu_ublp_escrow_root" name="UBLP Incoterms Escrow" sequence="90"/>
    <menuitem id="menu_ublp_escrow_deal" name="Deals" parent="menu_ublp_escrow_root"
              action="action_ublp_escrow_deal" sequence="10"/>

</odoo>
