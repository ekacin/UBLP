# Kurulum: önce `npm run setup -w @ublp/l2-verifier-evm` çalıştırın — Foundry'yi otomatik
# kurar, kontratı derler ve test eder. Solidity/Foundry bilmenize gerek yok.

# EVM zincirine bağlanmak için RPC URL'si — operatör kendi zincirini seçer (chain-agnostic tasarım)
L2_RPC_URL=http://localhost:8545

# Opsiyonel — RPC'nin beklenen chain ID ile eşleştiğini doğrular (yanlış ağa bağlanmayı önler)
L2_CHAIN_ID=31337

# Succinct SP1 doğrulayıcı (ISP1Verifier) kontratının hedef zincirdeki adresi
SP1_VERIFIER_ADDRESS=

# Bu modülün deploy ettiği Settlement kontratının adresi (bkz. contracts/script/Deploy.s.sol)
SETTLEMENT_CONTRACT_ADDRESS=

# SP1 programının GERÇEK doğrulama anahtarı (bytes32, hex) — cargo prove / sp1_sdk vk.bytes32() çıktısı.
# UYARI: gerçek SP1 proving altyapısı henüz kurulmadı — bu değer o iş bitene kadar yalnızca
# mock-verifier testlerinde kullanılabilir; production'a SHA256-fallback bir değerle ÇIKMAYIN.
SP1_PROGRAM_VKEY=

# settle() işlemini imzalayıp gas ödeyen cüzdanın private key'ini şifreler (@ublp/shared'in
# walletKeyStorage'ı — AES-256-GCM + PBKDF2). Dosya yoksa ilk çalıştırmada otomatik oluşturulur.
# Ayarlanmazsa servis başlamaz — private key asla plaintext env var olarak saklanmaz.
L2_SETTLER_KEY_PASSPHRASE=

# Opsiyonel — şifreli anahtar dosyasının yolu (varsayılan: data/settler.key.enc)
L2_SETTLER_KEY_PATH=data/settler.key.enc

# Bu servisin dinleyeceği port
L2_EVM_PORT=3006

# Opsiyonel — işlem receipt'i beklenirken kaç blok confirmation istenir
L2_TX_CONFIRMATIONS=1
