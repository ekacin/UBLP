{
  "name": "ublp",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "shared",
    "modules/zk-customs/types",
    "modules/zk-customs/ministry",
    "modules/zk-customs/ublp-agent",
    "modules/zk-customs/l2-verifier-mock",
    "modules/zk-customs/l2-verifier-evm",
    "modules/zk-customs/customs-broker",
    "modules/zk-customs/panel",
    "modules/incoterms-escrow/panel",
    "modules/incoterms-escrow"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "build:shared": "npm run build -w shared",
    "test:incoterms-escrow": "cd modules/incoterms-escrow && vitest run",
    "compile:escrow-contract": "npm run compile:contract -w @ublp/incoterms-escrow",
    "start:ministry": "npm run start -w @ublp/ministry",
    "start:agent": "npm run start -w @ublp/ublp-agent",
    "start:l2": "npm run start -w @ublp/l2-verifier-mock",
    "start:l2-evm": "npm run start -w @ublp/l2-verifier-evm",
    "start:broker": "npm run start -w @ublp/customs-broker",
    "smoke:broker": "npm run smoke -w @ublp/customs-broker",
    "smoke:l2-evm": "npm run smoke -w @ublp/l2-verifier-evm",
    "setup:l2-evm": "npm run setup -w @ublp/l2-verifier-evm",
    "compile:settlement-contract": "npm run compile:contract -w @ublp/l2-verifier-evm",
    "test:settlement-contract": "npm run test:contract -w @ublp/l2-verifier-evm",
    "dev:zk-customs": "npm run build && concurrently --kill-others -n \"MINISTRY,AGENT,L2,BROKER\" -c \"green,magenta,blue,yellow\" \"npm run start:ministry\" \"wait-on tcp:3001 && npm run start:agent\" \"wait-on tcp:3002 && npm run start:l2\" \"wait-on tcp:3001 tcp:3002 tcp:3003 && npm run start:broker\"",
    "test": "cd modules/zk-customs && vitest run",
    "test:unit": "cd modules/zk-customs && vitest run tests/unit/",
    "test:integration": "cd modules/zk-customs && vitest run tests/integration/",
    "test:negative": "cd modules/zk-customs && vitest run tests/negative/",
    "test:e2e": "cd modules/zk-customs && vitest run tests/integration/e2e.test.ts",
    "test:watch": "cd modules/zk-customs && vitest",
    "test:coverage": "cd modules/zk-customs && vitest run --coverage"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^2.1.0",
    "concurrently": "^8.2.2",
    "typescript": "^5.4.5",
    "vitest": "^2.1.0",
    "wait-on": "^9.0.10"
  },
  "overrides": {
    "@midnight-ntwrk/ledger-v8": "8.1.1",
    "@midnight-ntwrk/onchain-runtime-v3": "3.0.0"
  },
  "allowScripts": {
    "esbuild@0.21.5": true,
    "msgpackr-extract@3.0.4": true,
    "classic-level@3.0.0": true,
    "protobufjs@7.6.5": true,
    "ssh2@1.17.0": true,
    "cpu-features@0.0.10": true,
    "better-sqlite3@13.0.3": true
  }
}
