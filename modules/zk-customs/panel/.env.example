# Which side of the pipeline this deployment of the panel serves. Fixed per deployment —
# Ministry and Broker are genuinely separate organizations, each running their own copy of
# this same codebase pointed at their own backend, not a shared app switching between roles.
VITE_SERVICE_ROLE=broker
# broker (default port 3005):
VITE_AGENT_BASE_URL=http://localhost:3005
# ministry (default port 3001):
# VITE_SERVICE_ROLE=ministry
# VITE_AGENT_BASE_URL=http://localhost:3001
