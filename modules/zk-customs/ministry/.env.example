# Private key şifrelemesi (AES-256-GCM + PBKDF2)
# Ayarlanmazsa private key plaintext saklanır — sadece geliştirme!
MINISTRY_KEY_PASSPHRASE=

# Memur girişi (panel) için parola — ayarlanmazsa officer login devre dışı kalır
MINISTRY_OPERATOR_PASSPHRASE=

# Broker'dan gelen istekleri doğrulayan paylaşılan anahtar (x-api-key header'ı).
# Broker tarafında da AYNI değer MINISTRY_BROKER_API_KEY olarak ayarlanmalı.
# Ayarlanmazsa broker-facing route'lar korumasız kalır — sadece geliştirme!
MINISTRY_BROKER_API_KEY=

# DID ve servis URL'leri (varsayılanlar çalışır)
MINISTRY_DID=did:ublp:ministry
COMMITTEE_URL=http://localhost:3004
